<?xml version="1.0" encoding="utf-8"?>
<!-- Android 12+ : only the small automatic backup copy is saved or transferred. Nothing else
     (database, settings file, ads data) is included. -->
<data-extraction-rules>
    <cloud-backup>
        <include domain="file" path="auto_backup.json"/>
    </cloud-backup>
    <device-transfer>
        <include domain="file" path="auto_backup.json"/>
    </device-transfer>
</data-extraction-rules>
